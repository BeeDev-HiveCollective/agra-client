# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
#PassengerAppRoot "/home/thehives/public_html/hiveSites/hive-66"
#PassengerBaseURI "/"
#PassengerNodejs "/home/thehives/nodevenv/public_html/hiveSites/hive-66/20/bin/node"
#PassengerAppType node
#PassengerStartupFile vite.config.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.hive-11.beedev-services\.com$ [NC]
  RewriteRule ^ https://hive-11.beedev-services.com%{REQUEST_URI} [R=301,L]

  # Bypass — let /agra through immediately
  RewriteCond %{HTTP_HOST} ^(www\.)?hive-11.beedev-services\.com$ [NC]
  RewriteRule ^agra(/.*)?$ /index.html [END]

  # MAINTENANCE MODE (uncomment to enable)
  # RewriteCond %{HTTP_HOST} ^(www\.)?hive-11.beedev-services\.com$ [NC]
  # RewriteRule ^ https://maintenance.beedev-services.com/client/agra [R=302,L]

  # SPA fallback
  RewriteCond %{HTTP_HOST} ^(www\.)?hive-11.beedev-services\.com$ [NC]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]

</IfModule>
